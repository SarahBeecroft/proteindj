                new RFDEngine([design_mode: "rfd_denovo", design_length: "65-150", flexible_residues: "A10-20"], false).validateParams()
            } catch (IllegalArgumentException e) {
                threwDenovo = true
            }
            assert threwDenovo
        }
    }

    test("RFDEngine.validateParams accepts flexible_residues for binder rfd_denovo") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            new RFDEngine([design_mode: "rfd_denovo", design_length: "65-150", input_pdb: "some.pdb", flexible_residues: "B10-20"], true).validateParams()
        }
    }

    test("RFDEngine.validateParams rejects an invalid flexible_residues format") {
        when {
