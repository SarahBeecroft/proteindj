        }
        then {
            assert function.success
            def params = [design_mode: "boltzgen_motifscaff", input_pdb: "some.pdb", motifscaff_spec: "7-10,A1-60,5,A70-100,10"]
            new BoltzGenEngine(params, false).validateParams()
        }
    }

