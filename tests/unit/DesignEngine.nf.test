    test("RFDiffusionParams expands a chain-qualified range hotspot for rfd_denovo binder mode") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            def params = [design_mode: "rfd_denovo", is_binder_mode: true, input_pdb: "${projectDir}/lib/examplebinder.pdb", hotspot_residues: "A1-3"]
            def cmd = new RFDiffusionParams(params).generateCommandString()
            assert cmd.contains("ppi.hotspot_res=[A1,A2,A3]")
        }
    }

    test("RFDiffusionParams expands a bare chain ID hotspot to every residue present in that chain") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            def params = [design_mode: "rfd_denovo", is_binder_mode: true, input_pdb: "${projectDir}/lib/examplebinder.pdb", hotspot_residues: "A"]
            def cmd = new RFDiffusionParams(params).generateCommandString()
            assert cmd.contains("ppi.hotspot_res=[A1,A2,A3,A4,A5")
            assert cmd.contains("A87,A88]")
        }
    }

    test("RFDiffusionParams rejects a hotspot token without a chain identifier") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """ 
            }
        }
        then {
            assert function.success
            def threw = false
            try {
                def params = [design_mode: "rfd_denovo", is_binder_mode: true, input_pdb: "${projectDir}/lib/examplebinder.pdb", hotspot_residues: "10-15"]
                new RFDiffusionParams(params).generateCommandString()
            } catch (IllegalArgumentException e) {
                threw = true
            }
            assert threw
        }
    }

    test("RFDiffusionParams translates rfd_partialdiff_fixed_seq into flat 0-indexed contigmap.provide_seq") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            // examplebinder.pdb chain A spans residues 1-88, so A1-3 and A5 map to flat indices 0-2 and 4
            def params = [design_mode: "rfd_partialdiff", is_binder_mode: true, input_pdb: "${projectDir}/lib/examplebinder.pdb", rfd_partialdiff_timesteps: 20, rfd_partialdiff_fixed_seq: "A1-3,A5"]
            def cmd = new RFDiffusionParams(params).generateCommandString("[88-88/0 B89-203]")
            assert cmd.contains("contigmap.provide_seq=[0-2,4-4]")
        }
    }

    test("RFDiffusionParams rejects rfd_partialdiff_fixed_seq referencing a non-design chain") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            def threw = false
            try {
                def params = [design_mode: "rfd_partialdiff", is_binder_mode: true, input_pdb: "${projectDir}/lib/examplebinder.pdb", rfd_partialdiff_timesteps: 20, rfd_partialdiff_fixed_seq: "B90-92"]
                new RFDiffusionParams(params).generateCommandString("[88-88/0 B89-203]")
            } catch (IllegalArgumentException e) {
                threw = true
            }
            assert threw
        }
    }

    test("RFDiffusionParams auto-generates rfd_motifscaff contigs from motifscaff_spec for binder mode") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            // examplebinder.pdb: chain A residues 1-88 (binder), chain B residues 89-203 (target)
            def params = [design_mode: "rfd_motifscaff", is_binder_mode: true, input_pdb: "${projectDir}/lib/examplebinder.pdb", motifscaff_spec: "5-10,A1-88,10-20"]
            def cmd = new RFDiffusionParams(params).generateCommandString(RFDiffusionParams.AUTO_CONTIGS_SENTINEL)
            assert cmd.contains("contigmap.contigs=[5-10 A1-88 10-20/0 B89-203]")
        }
    }

    test("RFDiffusionParams defaults rfd_motifscaff binder mode to the complex_base checkpoint") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            def params = [design_mode: "rfd_motifscaff", is_binder_mode: true, input_pdb: "${projectDir}/lib/examplebinder.pdb", motifscaff_spec: "5-10,A1-88,10-20"]
            def cmd = new RFDiffusionParams(params).generateCommandString(RFDiffusionParams.AUTO_CONTIGS_SENTINEL)
            assert cmd.contains("inference.ckpt_override_path=/app/RFdiffusion/models/Complex_base_ckpt.pt")
        }
    }

    test("RFDiffusionParams does not force complex_base for rfd_motifscaff binder mode when motifscaff_inpaint_seq is set") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            def params = [
                design_mode: "rfd_motifscaff",
                is_binder_mode: true,
                input_pdb: "${projectDir}/lib/examplebinder.pdb",
                motifscaff_spec: "5-10,A1-88,10-20",
                motifscaff_inpaint_seq: "A10-20",
            ]
            def cmd = new RFDiffusionParams(params).generateCommandString(RFDiffusionParams.AUTO_CONTIGS_SENTINEL)
            assert !cmd.contains("inference.ckpt_override_path")
        }
    }

    test("RFDiffusionParams does not force complex_base for rfd_motifscaff binder mode when flexible_residues is set") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            def params = [
                design_mode: "rfd_motifscaff",
                is_binder_mode: true,
                input_pdb: "${projectDir}/lib/examplebinder.pdb",
                motifscaff_spec: "5-10,A1-88,10-20",
                flexible_residues: "B90-95",
            ]
            def cmd = new RFDiffusionParams(params).generateCommandString(RFDiffusionParams.AUTO_CONTIGS_SENTINEL)
            assert !cmd.contains("inference.ckpt_override_path")
        }
    }

    test("RFDiffusionParams respects an explicit rfd_ckpt_override for rfd_motifscaff binder mode") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            def params = [
                design_mode: "rfd_motifscaff",
                is_binder_mode: true,
                input_pdb: "${projectDir}/lib/examplebinder.pdb",
                motifscaff_spec: "5-10,A1-88,10-20",
                rfd_ckpt_override: "complex_beta",
            ]
            def cmd = new RFDiffusionParams(params).generateCommandString(RFDiffusionParams.AUTO_CONTIGS_SENTINEL)
            assert cmd.contains("inference.ckpt_override_path=/app/RFdiffusion/models/Complex_beta_ckpt.pt")
        }
    }

    test("RFDiffusionParams does not default the checkpoint for rfd_motifscaff monomer mode") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            def params = [design_mode: "rfd_motifscaff", is_binder_mode: false, input_pdb: "${projectDir}/lib/examplebinder.pdb", motifscaff_spec: "5-10,A1-88,10-20"]
            def cmd = new RFDiffusionParams(params).generateCommandString(RFDiffusionParams.AUTO_CONTIGS_SENTINEL)
            assert !cmd.contains("inference.ckpt_override_path")
        }
    }

    test("RFDiffusionParams auto-generates rfd_motifscaff contigs for monomer mode without a target chain") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            def params = [design_mode: "rfd_motifscaff", is_binder_mode: false, input_pdb: "${projectDir}/lib/examplebinder.pdb", motifscaff_spec: "5-10,A1-88,10-20"]
            def cmd = new RFDiffusionParams(params).generateCommandString(RFDiffusionParams.AUTO_CONTIGS_SENTINEL)
            assert cmd.contains("contigmap.contigs=[5-10 A1-88 10-20]")
            assert !cmd.contains("/0 B")
        }
    }

    test("RFDiffusionParams translates motifscaff_inpaint_seq and flexible_residues into contigmap.inpaint_seq/inpaint_str") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            def params = [
                design_mode: "rfd_motifscaff",
                is_binder_mode: true,
                input_pdb: "${projectDir}/lib/examplebinder.pdb",
                motifscaff_spec: "A1-88",
                motifscaff_inpaint_seq: "A10-20,A60",
                flexible_residues: "A30-35",
            ]
            def cmd = new RFDiffusionParams(params).generateCommandString(RFDiffusionParams.AUTO_CONTIGS_SENTINEL)
            assert cmd.contains("contigmap.inpaint_seq=[A10-20/A60]")
            assert cmd.contains("contigmap.inpaint_str=[A30-35]")
        }
    }

    test("RFDiffusionParams expands a bare chain ID in flexible_residues to the chain's full range") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            def params = [
                design_mode: "rfd_motifscaff",
                is_binder_mode: true,
                input_pdb: "${projectDir}/lib/examplebinder.pdb",
                motifscaff_spec: "A1-88",
                flexible_residues: "B",
            ]
            def cmd = new RFDiffusionParams(params).generateCommandString(RFDiffusionParams.AUTO_CONTIGS_SENTINEL)
            assert cmd.contains("contigmap.inpaint_str=[B89-203]")
        }
    }

    test("RFDiffusionParams auto-generates rfd_partialdiff contigs from rfd_partialdiff_spec for binder mode") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            // examplebinder.pdb: chain A residues 1-88 (binder), chain B residues 89-203 (target)
            def params = [design_mode: "rfd_partialdiff", is_binder_mode: true, input_pdb: "${projectDir}/lib/examplebinder.pdb", rfd_partialdiff_spec: "A1-19,59", rfd_partialdiff_timesteps: 20]
            def cmd = new RFDiffusionParams(params).generateCommandString(RFDiffusionParams.AUTO_PARTIALDIFF_SENTINEL)
            assert cmd.contains("contigmap.contigs=[A1-19 59/0 B89-203]")
        }
    }

    test("RFDiffusionParams auto-generates rfd_partialdiff contigs for monomer mode without a target chain") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            def params = [design_mode: "rfd_partialdiff", is_binder_mode: false, input_pdb: "${projectDir}/lib/examplebinder.pdb", rfd_partialdiff_spec: "A1-19,59", rfd_partialdiff_timesteps: 20]
            def cmd = new RFDiffusionParams(params).generateCommandString(RFDiffusionParams.AUTO_PARTIALDIFF_SENTINEL)
            assert cmd.contains("contigmap.contigs=[A1-19 59]")
