    test("RFDiffusionParams translates flexible_residues into contigmap.inpaint_str for rfd_denovo binder mode") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            def params = [design_mode: "rfd_denovo", is_binder_mode: true, input_pdb: "${projectDir}/lib/examplebinder.pdb", flexible_residues: "A10-20"]
            def cmd = new RFDiffusionParams(params).generateCommandString("[88-88/0 B89-203]")
            assert cmd.contains("contigmap.inpaint_str=[A10-20]")
        }
    }

    test("RFDiffusionParams translates flexible_residues into contigmap.inpaint_str for rfd_foldcond binder mode") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            def params = [design_mode: "rfd_foldcond", is_binder_mode: true, input_pdb: "${projectDir}/lib/examplebinder.pdb", flexible_residues: "A10-20"]
            def cmd = new RFDiffusionParams(params).generateCommandString("NoContigsNeededForFoldConditioning")
            assert cmd.contains("contigmap.inpaint_str=[A10-20]")
        }
    }

    test("RFDiffusionParams translates flexible_residues into contigmap.inpaint_str for rfd_partialdiff binder mode") {
        when {
            function {
                """
                input[0] = "[A1-88/0]"
                """
            }
        }
        then {
            assert function.success
            def params = [design_mode: "rfd_partialdiff", is_binder_mode: true, input_pdb: "${projectDir}/lib/examplebinder.pdb", rfd_partialdiff_timesteps: 20, flexible_residues: "B90-95"]
            def cmd = new RFDiffusionParams(params).generateCommandString("[88-88/0 B89-203]")
            assert cmd.contains("contigmap.inpaint_str=[B90-95]")
        }
    }
}
