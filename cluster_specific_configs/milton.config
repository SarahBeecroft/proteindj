params {
    conda.enabled = false
    apptainer.enabled = true
    apptainer.autoMount = true
    apptainer.libraryDir = '/vast/projects/alphafold/databases/predictedDb/containers/proteinDJ/library'
    apptainer.cacheDir = '/vast/scratch/users/${System.getenv('USER')}/.apptainer/cache'
    apptainer.pullTimeout = '20 min'
    singularity.enabled = false
    docker.enabled = false
    rfd_models = '/vast/projects/alphafold/databases/predictedDb/RFDiffusion/models'
    rfd4_models = '/vast/projects/alphafold/databases/predictedDb/containers/proteinDJ/rfd4models'
    rfd4_triton_cache = "/vast/scratch/users/${System.getenv('USER')}/.rfd4_cache"
    mpnn_models = '/vast/projects/alphafold/databases/predictedDb/containers/proteinDJ/mpnn'
    af2_models = '/vast/projects/alphafold/databases/params_2022-12-06'
    boltz_models = '/vast/projects/alphafold/databases/predictedDb/containers/proteinDJ/boltzmodels'
    bg_models = '/vast/projects/alphafold/databases/predictedDb/containers/proteinDJ/boltzgenmodels'
    af2_jax_compilation_cache_dir = "/vast/scratch/users/${System.getenv('USER')}/.af2_cache"
    gpu_queue = 'gpuq'

    process {
        withLabel: gpu {
            clusterOptions = '--gres=gpu:' + "${params.gpu_model}" + ':1'
        }
    }
}