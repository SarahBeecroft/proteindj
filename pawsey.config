/*
 * ============================================================================
 *  ProteinDJ - Pawsey Setonix profile (AMD MI250X / ROCm)
 * ============================================================================
 *  Usage:
 *      export NXF_SINGULARITY_CACHEDIR=$MYSOFTWARE/.singularity
 *      nextflow run main.nf -profile <design_mode> -c pawsey.config
 *
 *  Structure follows the working nf-core/proteinfold Setonix profile
 *  (example_proteinfold.config). That file is only the pipeline-specific
 *  half; the other half comes from nf-core/configs conf/pawsey_setonix.config,
 *  which ProteinDJ has no equivalent of. Both halves are reproduced here.
 *
 *  Setonix facts this config encodes
 *  ---------------------------------
 *  * GPU work is charged to <project>-gpu on partition 'gpu'.
 *    CPU work is charged to <project> on 'work' (or 'highmem' above 230 GB).
 *  * There is NO gres type on Setonix. Use "--gres=gpu:N".
 *    nextflow.config's default is "--gres=gpu:A30:1" (NVIDIA-shaped) and
 *    Slurm rejects it with "Invalid generic resource (gres) specification".
 *  * A GPU allocation pack = 1 GCD (half an MI250X) + 8 CPU cores + ~29 GB.
 *  * "--nv" is NVIDIA-only and must not appear in containerOptions.
 *
 *  Two Nextflow behaviours this file works around
 *  ----------------------------------------------
 *  1. Every GPU override uses `withName:`, never `withLabel:`, exactly as
 *     example_proteinfold.config does. `withName` outranks `withLabel`
 *     unconditionally, so these win over nextflow.config's
 *     `withLabel: 'gpu'` and `withLabel: '<tool>'` blocks regardless of
 *     config merge order.
 *  2. clusterOptions is written into ONE #SBATCH line. A triple-quoted
 *     multi-line string leaks whitespace and, where a `\` continuation has
 *     no preceding space, silently concatenates flags
 *     (e.g. "--gres=gpu:1--mem=0"). Keep every clusterOptions on one line.
 *
 *  Note on params.gpus: it is NOT "GPUs per job". main.nf uses it as
 *  num_batches = min(params.gpus, params.num_designs), i.e. the number of
 *  CONCURRENT single-GCD tasks. The *_gcds params below stay at 1.
 * ============================================================================
 */

params {
    config_profile_description = 'ProteinDJ Pawsey Setonix HPC profile'
    config_profile_contact     = 'Sarah Beecroft (@SarahBeecroft)'
    config_profile_url         = 'https://support.pawsey.org.au/documentation/display/US/Setonix+User+Guide'

    // Number of GCDs per process
    rfdiffusion_gcds = 1
    alphafold2_gcds  = 1
    boltz_gcds       = 1
    bindcraft_gcds   = 1
    fampnn_gcds      = 1

    // Concurrent GPU tasks == number of design batches. 8 == one GPU node.
    gpus = 8

    // CPU-only jobs on 'work'
    cpus       = 16
    memory_cpu = '32.GB'

    // ---- Model / weight locations ----------------------------------------
    // These are bind-mount SOURCES, so they must be directories, not globs.

    // Must contain params_model_*.npz from alphafold_params_2022-12-06.
    // Verify with: ls /scratch/references/alphafold_feb2024/databases/params
    af2_models   = '/scratch/references/alphafold_feb2024/databases/params'

    // Must contain boltz2_conf.ckpt, boltz2_aff.ckpt, ccd.pkl, mols/
    boltz_models = '/scratch/references/proteinfold_jun2026/params'

    // Must contain the 8 RFdiffusion *.pt checkpoints
    rfd_models   = '/scratch/references/proteindj/models/rfd'

    // ---- Compilation caches (same layout as the proteinfold profile) ------
    alphafold2_jax_compilation_cache_dir = "${System.getenv('MYSOFTWARE')}/jax_cache/proteindj_af2"
    bindcraft_jax_compilation_cache_dir  = "${System.getenv('MYSOFTWARE')}/jax_cache/proteindj_bindcraft"
}

/* --------------------------------------------------------------------------
 *  Half 1: what nf-core/configs conf/pawsey_setonix.config normally provides.
 *  ProteinDJ has no institutional base config, so it lives here.
 * ------------------------------------------------------------------------ */

singularity {
    enabled     = true
    autoMounts  = true        // NB: 'autoMounts', plural. nextflow.config's
                              // singularity/apptainer profiles say 'autoMount',
                              // which Nextflow silently ignores.
    autoCleanUp = true
    cacheDir    = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${System.getenv('MYSOFTWARE')}/.singularity"
}
apptainer.enabled = false
docker.enabled    = false
conda.enabled     = false

executor {
    queueSize = 1024
}

// Setonix requires I/O on /scratch. nf-core assumes you already launched from
// there; ProteinDJ users usually launch from the repo, so pin it explicitly.
workDir = "${System.getenv('MYSCRATCH')}/proteindj_work"

process {
    module         = 'singularity/3.11.4-nohost'
    resourceLimits = [ memory: 230.GB, cpus: 64 ]

    executor       = 'slurm'
    clusterOptions = "--account=${System.getenv('PAWSEY_PROJECT')}"
    module         = 'singularity/3.11.4-nohost'
    cache          = 'lenient'      // Lustre mtimes are not reliable
    stageInMode    = 'symlink'
    queue          = { task.memory && task.memory > 230.GB ? 'highmem' : 'work' }

    cpus   = params.cpus
    memory = params.memory_cpu
    time   = { 2.h * task.attempt }

    // nextflow.config sets time = { N.h * task.attempt } but never sets an
    // errorStrategy, so the multiplier never fires. Make retries real.
    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247,255] ? 'retry' : 'finish' }
    maxRetries    = 2

/* --------------------------------------------------------------------------
 *  Half 2: pipeline-specific overrides, mirroring example_proteinfold.config.
 *
 *  Every GPU block sets, in the same order as the proteinfold profile:
 *      container / containerOptions / queue / clusterOptions / time / cpus
 *
 *  cpus = 1 matches the proteinfold profile. No ProteinDJ GPU process reads
 *  task.cpus (only the python_tools / pyrosetta_tools CPU steps do), and the
 *  Setonix allocation pack hands over 8 cores per GCD regardless.
 *
 *  memory = null is required here and has no counterpart in the proteinfold
 *  profile: ProteinDJ's own withLabel:'gpu' sets memory = params.memory_gpu,
 *  so without this Nextflow emits "#SBATCH --mem 24576M" alongside the
 *  "--mem=0" in clusterOptions.
 *
 *  containerOptions must keep every bind from nextflow.config. RunRFD,
 *  RunAF2 and RunFAMPNN all call /scripts/metadata_converter.py, so dropping
 *  --bind ${projectDir}/scripts:/scripts breaks them.
 * ------------------------------------------------------------------------ */

    withName: 'RunRFD' {
        // VERIFY: image must expose /app/RFdiffusion/scripts/run_inference.py
        // (ProteinDJ uses the PapenfussLab/RFdiffusion fork @ 0938f87).
        container        = 'quay.io/pawsey/rfdiffusion:rocm7.0.0_dgl2.4.0'
        containerOptions = "-B ${params.rfd_models}:/app/RFdiffusion/models -B ./schedules:/app/RFdiffusion/schedules -B ./.dgl:\$HOME/.dgl -B ${projectDir}/scripts:/scripts -B ${projectDir}"
        queue            = 'gpu'
        clusterOptions   = "--account=${System.getenv('PAWSEY_PROJECT')}-gpu --nodes=1 --gres=gpu:${params.rfdiffusion_gcds} --mem=0 --ntasks=${params.rfdiffusion_gcds}"
        time             = { 2.h * task.attempt }
        cpus             = 1
        memory           = null
    }

    withName: 'RunAF2' {
        // VERIFY: this is AF2 *Initial-Guess* from PapenfussLab/dl_binder_design,
        // NOT nf-core/proteinfold AlphaFold2. The image must expose
        // /dl_binder_design/af2_initial_guess/predict.py.
        container        = 'quay.io/pawsey/alphafold2:proteinfold'
        containerOptions = "-B ${System.getenv('MYSOFTWARE')} -B ${params.af2_models}:/dl_binder_design/af2_initial_guess/model_weights/params -B ${projectDir}/scripts:/scripts -B ${projectDir} --env JAX_COMPILATION_CACHE_DIR=${params.alphafold2_jax_compilation_cache_dir} --env AMD_COMGR_CACHE_DIR=${params.alphafold2_jax_compilation_cache_dir}"
        queue            = 'gpu'
        clusterOptions   = "--account=${System.getenv('PAWSEY_PROJECT')}-gpu --nodes=1 --gres=gpu:${params.alphafold2_gcds} --mem=0 --ntasks=${params.alphafold2_gcds}"
        time             = { 1.h * task.attempt }
        cpus             = 1
        memory           = null
    }

    withName: 'RunBoltz' {
        container        = 'quay.io/pawsey/boltz2:v2.2.1_rocm6.4.1'
        // /boltzcache must be writable if Boltz needs to fetch anything.
        containerOptions = "-B ${params.boltz_models}:/boltzcache -B ${projectDir}/scripts:/scripts -B ${projectDir}"
        queue            = 'gpu'
        clusterOptions   = "--account=${System.getenv('PAWSEY_PROJECT')}-gpu --nodes=1 --gres=gpu:${params.boltz_gcds} --mem=0 --ntasks=${params.boltz_gcds}"
        time             = { 2.h * task.attempt }
        cpus             = 1
        memory           = null
    }

    withName: 'RunBC' {
        // VERIFY: ProteinDJ calls /opt/BindCraft/bindcraft.py and PrepBC writes
        // af_params_dir=/af2params into the settings JSON, so both paths must
        // exist in the image. FreeBindCraft may lay these out differently.
        // ROCR/HIP pinning copied from the proteinfold AF3 block: BindCraft is
        // JAX and otherwise enumerates every GCD it can see.
        container        = 'quay.io/pawsey/freebindcraft:v1.0.5_rocm7.0.2_nopyrosetta'
        containerOptions = "-B ${System.getenv('MYSOFTWARE')} -B ${params.af2_models}:/af2params --env JAX_PLATFORMS=rocm,cpu --env ROCR_VISIBLE_DEVICES=0 --env HIP_VISIBLE_DEVICES=0 --env JAX_COMPILATION_CACHE_DIR=${params.bindcraft_jax_compilation_cache_dir} --env AMD_COMGR_CACHE_DIR=${params.bindcraft_jax_compilation_cache_dir}"
        queue            = 'gpu'
        clusterOptions   = "--account=${System.getenv('PAWSEY_PROJECT')}-gpu --nodes=1 --gres=gpu:${params.bindcraft_gcds} --mem=0 --ntasks=${params.bindcraft_gcds}"
        time             = { 8.h * task.attempt }
        cpus             = 1
        memory           = null
    }

    withName: 'RunFAMPNN' {
        // TODO: no ROCm build exists yet. The upstream image is CUDA-only and
        // will fail on MI250X. Only needed when seq_method = 'fampnn'.
        // Must expose /app/fampnn/fampnn/inference/seq_design.py and
        // /app/fampnn/weights/fampnn_0_3.pt.
        // `container` is deliberately NOT set: a -c file cannot resolve
        // ${params.container_registry} from nextflow.config (Nextflow aborts
        // with "Unknown config attribute"). Inheriting it and overriding only
        // containerOptions is what strips --nv.
        containerOptions = "-B ${projectDir}/scripts:/scripts -B ${projectDir} --env TRITON_CACHE_DIR=/tmp/triton_cache --env XDG_CACHE_HOME=/tmp"
        queue            = 'gpu'
        clusterOptions   = "--account=${System.getenv('PAWSEY_PROJECT')}-gpu --nodes=1 --gres=gpu:${params.fampnn_gcds} --mem=0 --ntasks=${params.fampnn_gcds}"
        time             = { 2.h * task.attempt }
        cpus             = 1
        memory           = null
    }

    // RunMPNN is CPU-only: modules/proteinmpnn.nf declares `label 'MPNN'` and
    // `cpus 2` with NO `label 'gpu'`, and nextflow.config gives it no --nv.
    // Sending it to the gpu partition burns GPU allocation for nothing.
    // The upstream image is x86-64 CPU torch, so it needs no ROCm rebuild.
    withName: 'RunMPNN' {
        queue  = 'work'
        cpus   = 4
        memory = '16.GB'
        time   = { 4.h * task.attempt }
    }

    // Rosetta-heavy analysis step.
    withName: 'AnalysePredictions' {
        time = { 8.h * task.attempt }
    }
}
